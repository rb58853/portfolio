# .env — copy this file, rename it .env, and fill in your secrets
# Never commit .env to version control

# Optional: override the port exposed on the host (default: 3000)
PORT=3000

# Optional: base path if serving from a sub-path (default: /)
PUBLIC_URL=/

# GitHub personal access token used to fetch contribution data
REACT_APP_GITHUB_TOKEN=

# ── AI assistant backend ─────────────────────────────────────────────

# Provider key for the assistant model (LiteLLM reads it from the environment)
GROQ_API_KEY=

# Optional: LiteLLM model ids (defaults: groq/openai/gpt-oss-120b, then
# groq/meta-llama/llama-4-scout-17b-16e-instruct)
LLM_MODEL=
LLM_FALLBACK_MODELS=

# Optional: names the assistant must never write, confirm or deny (comma separated)
CHAT_BLOCKED_TERMS=

# Optional: browser origins allowed to open the chat, e.g. https://example.com
# (comma separated, empty = any)
ALLOWED_ORIGINS=
