# backend/.env — local development only. In Docker these come from the root .env.
# Never commit .env to version control

# Provider key for the model below (LiteLLM reads it from the environment)
GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional: LiteLLM model ids (defaults shown)
# LLM_MODEL=groq/openai/gpt-oss-120b
# LLM_FALLBACK_MODELS=groq/meta-llama/llama-4-scout-17b-16e-instruct

# Optional: names the assistant must never write, confirm or deny (comma separated)
CHAT_BLOCKED_TERMS=

# Optional: browser origins allowed to open the chat (comma separated, empty = any)
ALLOWED_ORIGINS=
