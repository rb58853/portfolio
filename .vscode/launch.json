{
  "version": "0.2.0",
  "configurations": [
    {
      // F5: starts the dev server and opens Chrome with the debugger once it compiles.
      // The URL must match PORT in .env.
      "name": "Portfolio: app + Chrome",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start",
      "cwd": "${workspaceFolder}",
      "env": {
        "BROWSER": "none"
      },
      "serverReadyAction": {
        "pattern": "Compiled successfully|Compiled with warnings",
        "uriFormat": "http://localhost:3000",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}",
        "killOnServerStop": true
      }
    },
    {
      "name": "Portfolio: solo servidor",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start",
      "cwd": "${workspaceFolder}",
      "env": {
        "BROWSER": "none"
      }
    },
    {
      // Chat assistant API on :8787. Needs backend/.venv and backend/.env (see Quickstart.MD).
      "name": "Portfolio: backend del asistente",
      "type": "node-terminal",
      "request": "launch",
      "command": ".venv/bin/uvicorn app.main:app --port 8787 --reload --reload-dir app --reload-dir knowledge --reload-include '*.yaml'",
      "cwd": "${workspaceFolder}/backend"
    }
  ],
  "compounds": [
    {
      // One click: assistant backend, dev server and Chrome.
      "name": "Portfolio: todo (app + asistente)",
      "configurations": ["Portfolio: backend del asistente", "Portfolio: app + Chrome"],
      "stopAll": true
    }
  ]
}
